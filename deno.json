{
  "name": "@hiisi/tyvi-cli",
  "version": "0.1.0",
  "description": "CLI interface for tyvi devspace orchestration",
  "license": "MPL-2.0",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-run",
    "check": "deno check --unsafely-ignore-certificate-errors mod.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "run": "deno run --unsafely-ignore-certificate-errors --allow-all mod.ts"
  },
  "imports": {
    "@std/cli": "https://deno.land/std@0.224.0/cli/mod.ts",
    "@std/cli/parse-args": "https://deno.land/std@0.224.0/cli/parse_args.ts",
    "@std/fmt/colors": "https://deno.land/std@0.224.0/fmt/colors.ts",
    "@std/path": "https://deno.land/std@0.224.0/path/mod.ts"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true
  }
}
