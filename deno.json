{
  "name": "@hiisi/tyvi-cli",
  "version": "0.1.0",
  "description": "CLI interface for tyvi devspace orchestration",
  "license": "MPL-2.0",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-run",
    "check": "deno check mod.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "run": "deno run --allow-all mod.ts"
  },
  "imports": {
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "@std/fmt": "jsr:@std/fmt@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "tyvi": "../tyvi/mod.ts"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true
  }
}
